# Bu dosyayı .env olarak kopyalayıp şifreleri değiştirin:  cp .env.example .env

# Dışarıya açılan adres / port
HTTP_PORT=80
PUBLIC_URL=http://localhost          # HTTP_PORT 80 değilse portu ekleyin: http://localhost:8080

# Arayüz (nginx "/" isteklerini nereye yönlendirsin?)
#   http://frontend:3000              → Docker'daki Next.js (varsayılan, production)
#   http://host.docker.internal:3000  → bilgisayardaki `npm run dev` (geliştirme, anında yenilenir)
FRONTEND_UPSTREAM=http://frontend:3000

# PostgreSQL (uygulama veritabanı)
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_PORT=5432

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change_me_keycloak_db
KEYCLOAK_BFF_SECRET=change_me_bff_secret   # site girişi için Keycloak istemci sırrı

# Redis
REDIS_PASSWORD=change_me_redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USER=ecommerce
RABBITMQ_PASSWORD=change_me_rabbitmq
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672

# iyzico (kartla ödeme) — https://sandbox-merchant.iyzipay.com > Ayarlar > Firma Ayarları
# Boş bırakılırsa ödeme sayfasında kart seçeneği hata verir, havale çalışır.
# Canlıya geçerken: IYZICO_BASE_URL=https://api.iyzipay.com ve canlı anahtarlar.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Sipariş e-postaları (SMTP) — boş bırakılırsa mail gönderilmez, site çalışmaya devam eder.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=adresiniz@gmail.com, SMTP_PASSWORD=<Google "uygulama şifresi">
# Brevo: SMTP_HOST=smtp-relay.brevo.com, kullanıcı ve şifre Brevo panelindeki SMTP anahtarı
# Port 587 (STARTTLS) kullanın; 465 desteklenmez.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Soykök Ticaret
# Yeni sipariş bildiriminin gideceği adres (sizin adresiniz)
ORDER_NOTIFY_EMAIL=
# Havale e-postasında gösterilecek hesap (boşsa mailde sipariş sayfasına bağlantı verilir)
BANK_NAME=
BANK_ACCOUNT_HOLDER=Soykök Ticaret
BANK_IBAN=
