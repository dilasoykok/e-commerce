{
  "realm": "soykok",
  "displayName": "Soykök Ticaret",
  "loginTheme": "soykok",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,
  "sslRequired": "external",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "tr",
    "en"
  ],
  "defaultLocale": "tr",
  "roles": {
    "realm": [
      {
        "name": "customer",
        "description": "Mağaza müşterisi"
      },
      {
        "name": "admin",
        "description": "Mağaza yöneticisi"
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-soykok",
    "composite": true,
    "composites": {
      "realm": [
        "offline_access",
        "uma_authorization",
        "customer"
      ]
    }
  },
  "clients": [
    {
      "clientId": "soykok-bff",
      "name": "Soykök Ticaret Web",
      "description": "Site girişi (backend üzerinden, oturum çerezi)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_BFF_SECRET}",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost/api/auth/callback",
        "http://localhost:5173/api/auth/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost/api/auth/signout-callback##http://localhost:5173/api/auth/signout-callback"
      },
      "protocolMappers": [
        {
          "name": "soykok-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "soykok-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "soykok-dev",
      "name": "Geliştirme / API testi (yalnızca yerel)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "soykok-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "soykok-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin@soykok.local",
      "email": "admin@soykok.local",
      "firstName": "Soykök",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Admin123!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-soykok",
        "admin"
      ]
    }
  ]
}
