<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Migrator: veritabanı migration'larını uygular, örnek veriyi yükler ve kapanır.
    Docker'da API'den önce çalışır. Ayrıca "dotnet ef" için başlangıç (startup) projesidir.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Soykok.Migrator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Soykok.Infrastructure/Soykok.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
